from microbit import *

lightsOn= False
clap= 0
while True:
    if microphone.was_event(SoundEvent.LOUD):
        lightsOn= True
        clap = clap+1
        if lightsOn:
            display.show(Image.HEART)
        else:
            display.clear()
        sleep(100)
        if clap==2:
            if microphone.was_event(SoundEvent.LOUD):
              lightsOn= False
            clap = 0
        else:
            display.clear()
